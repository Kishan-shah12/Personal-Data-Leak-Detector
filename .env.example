# ========================================================
# SENTINEL CORE // Environment Configuration Template
# Copy this file to .env and configure for your environment
# ========================================================

# Network Binding
HOST=0.0.0.0
PORT=8000

# MongoDB Telemetry Storage (Optional - falls back to memory cache if unavailable)
MONGO_URI=mongodb://localhost:27017
DB_NAME=sentinel_matrix

# In-Memory Quarantine Safety Bounds
MAX_UPLOAD_SIZE_MB=25
MAX_DECOMPRESSED_SIZE_MB=60
MAX_ZIP_RATIO=100
MAX_ARCHIVE_ENTRIES=500

# Server Environment Mode (development / production)
ENVIRONMENT=production

